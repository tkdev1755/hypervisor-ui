# Copier ce fichier en .env (à côté de docker-compose.yml) puis adapter les valeurs.
# docker compose le lit tout seul. Ne jamais committer .env.

# --- Image (Docker Hub : remialban/hypervisor-ui) ---
# La version à lancer : latest (dernier push sur main), ou un numéro (1.2.3) pour une version précise.
TAG=latest

# --- HTTPS (haproxy) ---
# Les deux fichiers DOIVENT exister, sinon haproxy (et donc le site) ne démarre pas.
# Pour essayer en local, un certificat auto-signé dans ./tls (le navigateur affichera un avertissement) :
#   mkdir -p tls && openssl req -x509 -newkey rsa:2048 -nodes -days 365 -subj "/CN=localhost" \
#     -keyout tls/key.pem -out tls/cert.pem && chmod 644 tls/key.pem
# Sur un vrai serveur, mettez les chemins de votre vrai certificat (Let's Encrypt : fullchain.pem et privkey.pem).
# Certificat du serveur (suivi de sa chaîne), en PEM.
TLS_CERT_PATH=./tls/cert.pem
# Clé privée, en PEM, non chiffrée, lisible par l'UID 99 (sur un serveur : chown 99:99 + chmod 400).
TLS_KEY_PATH=./tls/key.pem
# Ports publiés sur la machine : HTTP (redirigé vers HTTPS) et HTTPS.
# 80 et 443 sont réservés au front : les HAProxy de l'API (8081 / 8443) et de noVNC (6081 / 6443) en prennent d'autres.
HTTP_PORT=80
HTTPS_PORT=443

# --- API ---
# Le réseau Docker créé par le docker-compose de hypervisor-api (<dossier>_hypervisor-net).
API_NETWORK=hypervisor-api_hypervisor-net
# L'adresse de l'API vue depuis le conteneur du front : le HAProxy de l'API (api-haproxy = son service),
# sur son entrée HTTPS interne 9443, non publiée. Pas le conteneur de l'API directement.
API_UPSTREAM=https://api-haproxy:9443
# Certificat de l'API (auto-signé : son cert.pem ; Let's Encrypt : /etc/ssl/certs/ca-certificates.crt)
# et le nom qu'il porte, pour que nginx le vérifie.
API_CA_PATH=../hypervisor-api/tls/cert.pem
API_TLS_NAME=localhost

# --- Fausse API (seulement avec -f docker-compose.mock.yml) ---
# 1 : VM, disques, réseaux et templates d'exemple ; 0 : version « fidèle à l'API » (501).
MOCK_FULL=1
# L'adresse du site vue par le navigateur, pour la fausse console VNC.
PUBLIC_URL=https://localhost
